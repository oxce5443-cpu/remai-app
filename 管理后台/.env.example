# ============================================================
# 热麦管理后台环境变量模板
# 复制为 .env.development（本地）或 .env.production（构建）填入真实值
# 真实值一律在 uniCloud 控制台获取，不得提交仓库
# ============================================================

# uniCloud 提供商（阿里云固定 aliyun）
VITE_UNICLOUD_PROVIDER=aliyun

# uniCloud 空间 ID（uniCloud 控制台 → 空间概览）
VITE_UNICLOUD_SPACE_ID=mp-your-space-id

# uniCloud Web 端 clientSecret（uniCloud 控制台 → 服务空间 → Web 端关联）
# 注意：此值为前端可读取的受限密钥，不要与云函数环境变量 ADMIN_TOKEN_SECRET 混淆
VITE_UNICLOUD_CLIENT_SECRET=your-client-secret
